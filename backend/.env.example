# Application Environment: development | production | test
APP_ENV=development

# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hiring_radar

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Groq LLM configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated RSS feed URLs
RSS_FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss,https://weworkremotely.com/categories/remote-devops-sysadmin-jobs.rss

# Minimum cosine similarity (0-1) for semantic job matching
JOB_MATCH_SIMILARITY_THRESHOLD=0.30
