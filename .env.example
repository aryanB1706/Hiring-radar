# Copy to .env and adjust. Never commit .env.
APP_ENV=dev                 # dev | prod (prod = JSON logs)
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://hiring:hiring@localhost:5434/hiring_radar
REDIS_URL=redis://localhost:6380/0

# Host ports published by docker compose (defaults avoid clashing with local postgres/redis)
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6380

# LLM gateway (Google Gemini free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
LLM_RPM_LIMIT=5              # placeholder: set to your free-tier limit shown in Google AI Studio
LLM_CACHE_TTL_SECONDS=86400  # 0 disables the response cache
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60
# Cost table; empty = free tier (cost 0). Example (paid-tier prices seen 2026-10-30, verify first):
# LLM_PRICING={"gemini-3.8-flash":{"input_per_mtok":0.75,"output_per_mtok":3.75}}
LLM_PRICING={}

# Collectors
HTTP_USER_AGENT="HiringRadar/0.1 (+https://github.com/aryanB1706/Hiring-radar; portfolio project)"
HTTP_TIMEOUT_SECONDS=20
HTTP_MIN_DELAY_SECONDS=1.0   # minimum gap between requests to the same host
# Reddit official API (read-only app credentials): https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="script:hiring-radar:0.1 (by /u/your_reddit_username)"
SUBREDDITS=forhire,hiring,developersIndia,remotepython
INGEST_INTERVAL_HOURS=6

# Classifier / embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEDUPE_THRESHOLD=0.08        # max cosine distance to call two leads the same job
