# Application Environment: development | production | test
APP_ENV=development

# Database connection URL (PostgreSQL)
# Use localhost:5434 for local host development connecting to Docker Compose PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/hiring_radar

# Database port exposed on the host machine
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hiring_radar

# API port exposed on the host machine
API_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
